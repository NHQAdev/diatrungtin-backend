# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL 16+
DATABASE_URL=postgres://dtt:change_me@localhost:5432/dtt_dev
DATABASE_POOL_MAX=10

# Public URL of this API (image links) and of the shop frontend (links in emails).
API_PUBLIC_URL=http://localhost:4000
APP_PUBLIC_URL=http://localhost:5173

# Browser origins allowed to call the API (comma-separated). Required in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

ADMIN_SESSION_TTL_HOURS=12
CUSTOMER_SESSION_TTL_DAYS=30

# Defaults to true when NODE_ENV=production. Keep false only for plain-http local dev.
COOKIE_SECURE=false

# true when running behind a reverse proxy (Nginx, Caddy, a PaaS load balancer).
TRUST_PROXY=false

# Uploaded product images (back this folder up together with the database).
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# Email. Leave SMTP_HOST empty in development: emails are printed in the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Trầm Hương Địa Trung Tín <no-reply@example.com>
EMAIL_WORKER_ENABLED=true

# Tests only: a separate, disposable database. Its schema is dropped and recreated on every run.
TEST_DATABASE_URL=postgres://dtt:change_me@localhost:5432/dtt_test
