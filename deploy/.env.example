# Production settings. Copy to deploy/.env on the VPS and fill in. Never commit deploy/.env.
# Generate secrets with:  openssl rand -hex 24

# ---- Domains ----
API_DOMAIN=api.example.com
# Used in email links (order page, password reset):
APP_PUBLIC_URL=https://example.com
API_PUBLIC_URL=https://api.example.com
# Browser origins allowed to call the API (shop + admin frontends), comma-separated:
CORS_ORIGINS=https://example.com,https://admin.example.com

# ---- Database (container "db") ----
POSTGRES_DB=diatrungtin
POSTGRES_USER=diatrungtin
# Letters and digits only (it is placed inside a URL):
POSTGRES_PASSWORD=

# ---- App ----
LOG_LEVEL=info
COOKIE_SECURE=true
ADMIN_SESSION_TTL_HOURS=12
CUSTOMER_SESSION_TTL_DAYS=30
UPLOAD_MAX_MB=5

# ---- Email (required in production) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Trầm Hương Địa Trung Tín <no-reply@example.com>
EMAIL_WORKER_ENABLED=true
