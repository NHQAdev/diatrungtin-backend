# Caddy gets and renews the HTTPS certificate for API_DOMAIN automatically (Let's Encrypt).
# The DNS A record of API_DOMAIN must point to this VPS before the first start.
{$API_DOMAIN} {
	encode gzip
	reverse_proxy api:4000
}

