{
  "name": "diatrungtin-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend MVP cho website Trầm Hương Địa Trung Tín",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "admin": "tsx --env-file-if-exists=.env scripts/admin.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "kysely": "^0.27.6",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
